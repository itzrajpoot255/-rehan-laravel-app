pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Composer Dependencies') {
            steps {
                bat 'composer install --no-interaction --prefer-dist --optimize-autoloader'
            }
        }

        stage('Setup Environment File') {
            steps {
                bat '''
                    if not exist .env (
                        copy .env.example .env
                        php artisan key:generate
                    )
                '''
            }
        }

        stage('Deploy to Local Directory') {
            steps {
                bat '''
                    if not exist C:\\xampp\\htdocs\\laravel-local mkdir C:\\xampp\\htdocs\\laravel-local
                    xcopy /E /I /Y . C:\\xampp\\htdocs\\laravel-local
                '''
            }
        }
    }
}
