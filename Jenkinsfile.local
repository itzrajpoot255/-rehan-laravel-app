pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Composer Dependencies') {
            steps {
                bat 'composer install --no-interaction'
            }
        }

        stage('Setup Environment File') {
            steps {
                bat 'copy .env.example .env'
                bat 'php artisan key:generate'
            }
        }

        stage('Deploy to Local Directory') {
            steps {
                bat 'xcopy /E /I /Y . C:\\xampp\\htdocs\\laravel-local'
            }
        }
    }
}
