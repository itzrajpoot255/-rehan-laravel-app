pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Composer Dependencies') {
            steps {
                sh 'composer install --no-interaction --prefer-dist --optimize-autoloader'
            }
        }

        stage('Setup Environment File') {
            steps {
                sh '''
                    if [ ! -f .env ]; then
                        cp .env.example .env
                        php artisan key:generate
                    fi
                '''
            }
        }

        stage('Deploy to Local Directory') {
            steps {
                sh '''
                    mkdir -p /var/www/html/laravel-local
                    cp -r . /var/www/html/laravel-local/
                '''
            }
        }
    }
}
