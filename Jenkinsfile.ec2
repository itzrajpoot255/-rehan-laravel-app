pipeline {
    agent any

    environment {
        EC2_HOST = '16.170.227.192'
        EC2_USER = 'ubuntu'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Deploy Docker to AWS EC2') {
            steps {
                sshagent(['ec2-ssh-key']) {
                    sh 'ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} "sudo mkdir -p /var/www/html/laravel-docker && sudo chown -R ${EC2_USER}:${EC2_USER} /var/www/html/laravel-docker"'
                    sh 'scp -o StrictHostKeyChecking=no -r . ${EC2_USER}@${EC2_HOST}:/var/www/html/laravel-docker/'
                    sh 'ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} "cd /var/www/html/laravel-docker && sudo docker compose up -d --build"'
                }
            }
        }
    }
}
